# SimonSays V3 — server environment
#
# Copy to `.env` in this folder and fill in what you use. Everything is
# optional: a platform with no credentials simply stays disconnected.
#
# NOTE: none of these ever reach the browser. That is a deliberate change from
# V2, which inlined GEMINI_API_KEY into the frontend bundle.

# ---- server
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=info
# Reconnect platforms automatically on boot using stored credentials.
AUTO_START=true
# Where the UI is served from, used to build OAuth redirect URLs.
PUBLIC_URL=http://localhost:5173

# ---- twitch
# Create an app at https://dev.twitch.tv/console/apps
# Redirect URL must match PUBLIC_URL exactly.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- discord
# https://discord.com/developers/applications
# The bot needs the SERVER MEMBERS and MESSAGE CONTENT privileged intents.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# ---- spotify
# https://developer.spotify.com/dashboard
# Both of these are optional: the Connections screen has boxes for the client
# id and secret, and anything entered there is stored server-side and wins over
# these. Set them here only if you would rather not use the UI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_POLL_MS=3000

# ---- obs
# Tools -> WebSocket Server Settings inside OBS.
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
OBS_AUTOCONNECT=true

# ---- tiktok
# How often to retry connecting while the creator is offline (ms).
# Each retry spends a request against the signing service's rate limit, so
# keep this high unless you have a paid signing key.
TIKTOK_POLL_MS=300000

# Optional Euler Stream signing key (https://www.eulerstream.com).
# Without one you share the anonymous quota, which is easily exhausted.
TIKTOK_SIGN_API_KEY=

# ---- gemini (server-side TTS only)
GEMINI_API_KEY=
